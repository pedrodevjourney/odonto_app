# Variáveis do build de produção (o Vite lê em build time, não em runtime).
#
# Este arquivo é a fonte da verdade do build publicado: se ele existir, vence a
# variável definida no painel do Cloudflare Pages. Portanto o valor real mora aqui,
# versionado — não em placeholder.
VITE_API_BASE_URL=https://borges-odontologia.onrender.com

# Client ID OAuth do Google para a integração com o Google Calendar.
# Vazio = o botão do Google Calendar simplesmente não aparece (AgendaPage.tsx:106).
# Se preencher, cadastre https://odonto-app.pages.dev nas "Authorized JavaScript
# origins" do Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
